<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OdevSistemi.InstructorUI.Views.LogView">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Sistem Logları" FontSize="24"
                   FontWeight="Bold" Margin="0,0,0,12"/>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <TextBox x:Name="AramaKutusu" Width="280"
                     Watermark="Satırlarda ara (ör. öğrenci no)"
                     TextChanged="AramaKutusu_TextChanged"/>
            <Button Content="Yenile" Click="Yenile_Click"/>
        </StackPanel>

        <TextBlock x:Name="DurumMetni" DockPanel.Dock="Bottom" Foreground="Gray" Margin="0,8,0,0"/>

        <Grid ColumnDefinitions="220,12,*">
            <ListBox x:Name="DosyaListesi" Grid.Column="0"
                     SelectionChanged="DosyaListesi_SelectionChanged"/>
            <TextBox x:Name="LogIcerigi" Grid.Column="2"
                     IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                     FontFamily="Menlo, Consolas, monospace" FontSize="13"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </Grid>
    </DockPanel>
</UserControl>