<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OdevSistemi.InstructorUI.Views.PdfIceAktarWindow"
        Title="PDF'den Soru Aktar" Width="1050" Height="650"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <TextBlock x:Name="BaslikMetni" DockPanel.Dock="Top" FontSize="20" FontWeight="Bold"/>
        <TextBlock x:Name="OzetMetni" DockPanel.Dock="Top" Foreground="Gray"
                   TextWrapping="Wrap" Margin="0,4,0,12"/>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
            <TextBlock Text="Kategori:" VerticalAlignment="Center"/>
            <AutoCompleteBox x:Name="KategoriKutusu" Width="240"
                             FilterMode="Contains" MinimumPrefixLength="0"/>
            <TextBlock Text="Soru puanı:" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <NumericUpDown x:Name="PuanKutusu" Width="130" Minimum="1" Maximum="100"
                           Value="10" Increment="1" FormatString="0"/>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button Content="Vazgeç" Click="Vazgec_Click"/>
                <Button Classes="accent" Content="Seçilenleri Soru Bankasına Ekle" Click="Ekle_Click"/>
            </StackPanel>
            <TextBlock x:Name="HataMesaji" Foreground="IndianRed"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>

        <DataGrid x:Name="Tablo" AutoGenerateColumns="False" CanUserSortColumns="False"
                  SelectionMode="Single" GridLinesVisibility="Horizontal"
                  DoubleTapped="Tablo_DoubleTapped">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="50">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Secili}" IsEnabled="{Binding Gecerli}"
                                      HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="No"          Binding="{Binding No}"         Width="50"  IsReadOnly="True"/>
                <DataGridTextColumn Header="Tür"         Binding="{Binding TurAdi}"     Width="130" IsReadOnly="True"/>
                <DataGridTextColumn Header="Soru"        Binding="{Binding Metin}"      Width="*"   IsReadOnly="True"/>
                <DataGridTextColumn Header="Doğru Cevap" Binding="{Binding CevapMetni}" Width="180" IsReadOnly="True"/>
                <DataGridTextColumn Header="Durum"       Binding="{Binding Durum}"      Width="200" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>