<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OdevSistemi.InstructorUI.Views.MainWindow"
        Title="Eğitmen Paneli" Width="1150" Height="720"
        WindowStartupLocation="CenterScreen">
    <Window.Styles>
        <Style Selector="Button.menu">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style Selector="Button.menu.secili">
            <Setter Property="Background" Value="#334155"/>
        </Style>
    </Window.Styles>

    <DockPanel>
        <Border DockPanel.Dock="Left" Width="220" Background="#1E293B" Padding="12">
            <DockPanel>
                <StackPanel x:Name="MenuPaneli" DockPanel.Dock="Top" Spacing="4">
                    <TextBlock Text="Eğitmen Paneli" FontSize="18" FontWeight="Bold"
                               Foreground="White" Margin="4,0,0,2"/>
                    <TextBlock x:Name="KullaniciEtiketi" Foreground="#94A3B8" Margin="4,0,0,16"/>
                    <Button Classes="menu" Content="Soru Bankası"      Tag="soru"     Click="Menu_Click"/>
                    <Button Classes="menu" Content="Sınav Oluştur"     Tag="sinav"    Click="Menu_Click"/>
                    <Button Classes="menu" Content="Sonuçlar"          Tag="sonuc"    Click="Menu_Click"/>
                    <Button Classes="menu" Content="Sistem Logları"    Tag="log"      Click="Menu_Click"/>
                </StackPanel>
                <Button Classes="menu" Content="Çıkış Yap" Click="Cikis_Click"
                        VerticalAlignment="Bottom"/>
            </DockPanel>
        </Border>

        <ContentControl x:Name="IcerikAlani" Margin="20"/>
    </DockPanel>
</Window>