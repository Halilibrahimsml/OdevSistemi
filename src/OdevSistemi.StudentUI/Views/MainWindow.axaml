<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OdevSistemi.StudentUI.Views.MainWindow"
        Title="Öğrenci Paneli"
        Width="1150" Height="720" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen">

  

  <Window.Styles>
    
    <Style Selector="Button.menu">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Padding" Value="12,10"/>
    </Style>

    <!-- Yan panel yazıları -->
    <Style Selector="TextBlock.panelBaslik">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Margin" Value="4,0,0,2"/>
    </Style>
    <Style Selector="TextBlock.panelSoluk">
      <Setter Property="Foreground" Value="#94A3B8"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    
    <Style Selector="TextBlock.baslik">
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    
    <Style Selector="Border.kart">
      <Setter Property="Background" Value="#F1F5F9"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14"/>
    </Style>
    <Style Selector="TextBlock.kartBaslik">
      <Setter Property="Foreground" Value="Gray"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="TextBlock.kartDeger">
      <Setter Property="FontSize" Value="24"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>

  </Window.Styles>

  <Grid>

    <!-- ============================ 1) GİRİŞ ============================ -->
    <Grid x:Name="LoginPanel">
      <StackPanel Width="360" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Öğrenci Girişi" FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,8"/>
        <TextBox x:Name="TxtIp" Watermark="Eğitmen IP adresi (ör. 192.168.1.20)"/>
        <TextBox x:Name="TxtUser" Watermark="Öğrenci numarası"/>
        <TextBox x:Name="TxtPass" Watermark="Şifre" PasswordChar="●"/>
        <TextBlock x:Name="LoginError" Foreground="IndianRed" TextWrapping="Wrap"/>
        <Button x:Name="BtnLogin" Classes="accent" Content="Giriş Yap" Click="OnLogin"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
        <Button x:Name="BtnDemo" Content="Sunucusuz dene (demo)" Click="OnDemo"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
        <TextBlock Text="İnternet gerekmez. Eğitmenle aynı ağda olman yeterli."
                   Foreground="Gray" FontSize="12" TextWrapping="Wrap"
                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0"/>
      </StackPanel>
    </Grid>

    <!-- ============================ 2) LOBİ ============================ -->
    <DockPanel x:Name="LobbyPanel" IsVisible="False">
      <Border DockPanel.Dock="Left" Width="220" Background="#1E293B" Padding="12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Spacing="4">
            <TextBlock Classes="panelBaslik" Text="Öğrenci Paneli"/>
            <TextBlock x:Name="LobbyName" Classes="panelSoluk" Text="Hoş geldin" Margin="4,0,0,16"/>
          </StackPanel>
          <Button Classes="menu" Content="Çıkış Yap" Click="OnLogout" VerticalAlignment="Bottom"/>
        </DockPanel>
      </Border>

      <StackPanel Margin="20" Spacing="12">
        <TextBlock Classes="baslik" Text="Sınav Bekleme Odası"/>

        <Border x:Name="PillBorder" HorizontalAlignment="Left" CornerRadius="8" Padding="10,4" Background="#D1FAE5">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse x:Name="PillDot" Width="8" Height="8" Fill="#059669" VerticalAlignment="Center"/>
            <TextBlock x:Name="PillText" Text="Bağlı" Foreground="#059669" FontWeight="SemiBold" FontSize="13"/>
          </StackPanel>
        </Border>

        <TextBlock Text="Eğitmen sınavı başlatınca sorular bu ekranda kendiliğinden açılır. Bu pencereyi kapatma."
                   TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"/>

        <UniformGrid Columns="2" MaxWidth="520" HorizontalAlignment="Left" Margin="0,4,0,0">
          <Border Classes="kart" Margin="0,0,10,0">
            <StackPanel>
              <TextBlock Classes="kartBaslik" Text="Sunucu"/>
              <TextBlock x:Name="LobbyServer" Classes="kartDeger" Text="-"/>
            </StackPanel>
          </Border>
          <Border Classes="kart">
            <StackPanel>
              <TextBlock Classes="kartBaslik" Text="Bekleme Süresi"/>
              <TextBlock x:Name="LobbyWait" Classes="kartDeger" Text="00:00"/>
            </StackPanel>
          </Border>
        </UniformGrid>

        <Button x:Name="BtnDemoExam" Classes="accent" Content="Örnek sınavı başlat"
                IsVisible="False" Click="OnDemoExam" Margin="0,8,0,0"/>
      </StackPanel>
    </DockPanel>

    <!-- ============================ 3) SINAV ============================ -->
    <DockPanel x:Name="ExamPanel" IsVisible="False">

      <!-- Üst bilgi çubuğu -->
      <Border DockPanel.Dock="Top" Background="#1E293B" Padding="20,10">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="ExamTitle" Text="Sınav" Foreground="White" FontSize="18" FontWeight="Bold"/>
            <TextBlock x:Name="ExamProgress" Text="0 / 0 soru cevaplandı" Foreground="#94A3B8" FontSize="13"/>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <TextBlock Text="Kalan süre" Foreground="#94A3B8" VerticalAlignment="Center"/>
            <Border x:Name="TimerBorder" Background="#334155" CornerRadius="8" Padding="14,4" MinWidth="120">
              <TextBlock x:Name="TimerText" Text="00:00" Foreground="White"
                         FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
            </Border>
          </StackPanel>
        </Grid>
      </Border>

      <ProgressBar x:Name="TimeBar" DockPanel.Dock="Top" Minimum="0" Maximum="100" Value="100"
                   Height="4" MinHeight="4" CornerRadius="0" Background="#334155" Foreground="#94A3B8"/>

      <!-- Alt çubuk: bitir -->
      <Border DockPanel.Dock="Bottom" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,10">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Cevapların kendiliğinden saklanır. Süre bitince otomatik gönderilir."
                     Foreground="Gray" VerticalAlignment="Center"/>
          <Button x:Name="BtnFinish" Grid.Column="1" Classes="accent" Content="Bitir ve Gönder" Click="OnFinish"/>
        </Grid>
      </Border>

      <!-- Sol: soru numaraları (eğitmendeki yan panel gibi) -->
      <Border DockPanel.Dock="Left" Width="220" Background="#1E293B" Padding="12">
        <ScrollViewer>
          <StackPanel Spacing="12">
            <TextBlock Classes="panelBaslik" Text="Sorular"/>
            <WrapPanel x:Name="NavPanel"/>
            <StackPanel Spacing="6" Margin="4,8,0,0">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="14" Height="14" CornerRadius="4" Background="#DCFCE7"/>
                <TextBlock Classes="panelSoluk" Text="Cevaplandı" FontSize="13"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="14" Height="14" CornerRadius="4" Background="#334155" BorderBrush="#F59E0B" BorderThickness="2"/>
                <TextBlock Classes="panelSoluk" Text="Sonra bak" FontSize="13"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="14" Height="14" CornerRadius="4" Background="#334155"/>
                <TextBlock Classes="panelSoluk" Text="Boş" FontSize="13"/>
              </StackPanel>
            </StackPanel>
            <TextBlock Classes="panelSoluk" FontSize="12" Margin="4,8,0,0"
                       Text="Kısayollar: ← → sorular arası, A B C D şık seçme."/>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Sağ: aktif soru -->
      <Grid RowDefinitions="*,Auto" Margin="20">
        <ScrollViewer x:Name="QScroll" Grid.Row="0">
          <StackPanel x:Name="QArea" MaxWidth="860" HorizontalAlignment="Left" Margin="0,0,8,0"/>
        </ScrollViewer>
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*,Auto" MaxWidth="860" Margin="0,12,0,0">
          <Button x:Name="BtnPrev" Grid.Column="0" Content="← Önceki" Click="OnPrev"/>
          <Button x:Name="BtnFlag" Grid.Column="1" Content="Sonra bak" Margin="8,0,0,0" Click="OnFlag"/>
          <Button x:Name="BtnNext" Grid.Column="3" Content="Sonraki →" Click="OnNext"/>
        </Grid>
      </Grid>
    </DockPanel>

    <!-- ===================== 4) GÖNDERİLDİ / SÜRE DOLDU ===================== -->
    <DockPanel x:Name="DonePanel" IsVisible="False">
      <Border DockPanel.Dock="Left" Width="220" Background="#1E293B" Padding="12">
        <StackPanel Spacing="4">
          <TextBlock Classes="panelBaslik" Text="Öğrenci Paneli"/>
          <TextBlock Classes="panelSoluk" Text="Sınav sonucu" Margin="4,0,0,16"/>
        </StackPanel>
      </Border>

      <StackPanel Margin="20" Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Border x:Name="DoneIcon" Width="40" Height="40" CornerRadius="20" Background="#F1F5F9" VerticalAlignment="Center">
            <TextBlock x:Name="DoneIconText" Text="…" FontSize="20" FontWeight="Bold" Foreground="#1E293B"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock x:Name="DoneTitle" Classes="baslik" Text="Sınavınız gönderiliyor…"
                     VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>

        <TextBlock x:Name="DoneText" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"/>

        <UniformGrid x:Name="DoneFacts" IsVisible="False" Columns="2" MaxWidth="520" HorizontalAlignment="Left" Margin="0,4,0,0">
          <Border Classes="kart" Margin="0,0,10,0">
            <StackPanel>
              <TextBlock Classes="kartBaslik" Text="Cevaplanan"/>
              <TextBlock x:Name="DoneAnswered" Classes="kartDeger" Text="-"/>
            </StackPanel>
          </Border>
          <Border Classes="kart">
            <StackPanel>
              <TextBlock Classes="kartBaslik" Text="Kullanılan Süre"/>
              <TextBlock x:Name="DoneUsed" Classes="kartDeger" Text="-"/>
            </StackPanel>
          </Border>
        </UniformGrid>

        <TextBlock x:Name="DoneError" Foreground="IndianRed" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left"/>

        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
          <Button x:Name="BtnRetry" Classes="accent" Content="Tekrar Göndermeyi Dene" IsVisible="False" Click="OnRetry"/>
          <Button x:Name="BtnBack" Content="Lobiye Dön" IsVisible="False" Click="OnBack"/>
        </StackPanel>
      </StackPanel>
    </DockPanel>

    <!-- ============================ Onay penceresi ============================ -->
    <Grid x:Name="ModalOverlay" IsVisible="False" Background="#991E293B">
      <Border Width="440" HorizontalAlignment="Center" VerticalAlignment="Center"
              Background="White" CornerRadius="8" Padding="24">
        <StackPanel Spacing="10">
          <TextBlock Text="Sınavı bitirmek istiyor musun?" FontSize="20" FontWeight="Bold"/>
          <TextBlock x:Name="ModalText" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Sınava Dön" Click="OnModalCancel"/>
            <Button Classes="accent" Content="Evet, Gönder" Click="OnModalOk"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

  </Grid>
</Window>
